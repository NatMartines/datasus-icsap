table fct_internacoes
	lineageTag: 715a56a1-a4bd-4878-b49c-39fae0f135c2

	measure Internações = COUNTROWS(fct_internacoes)
		formatString: 0
		lineageTag: 6f0ba69f-356b-4e0b-b3dc-51d45016b103

	measure 'Valor Total' = SUM(fct_internacoes[valor_total])
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: d007ae04-4c2e-48f7-b554-526b9ae38b01

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Internações Evitáveis' = CALCULATE([Internações], fct_internacoes[eh_evitavel] = 1)
		formatString: 0
		lineageTag: fa46b637-112b-46d1-924d-a3d795154f00

	measure '% Evitáveis' = DIVIDE([Internações Evitáveis], [Internações])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 20559475-bd34-4da9-94ee-61de256f0ecb

	measure 'Valor Evitável' = CALCULATE([Valor Total], fct_internacoes[eh_evitavel] = 1)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
